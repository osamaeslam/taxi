{
  "version": 2,
  "builds": [
    {
      "src": "server.ts",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["migrations/**", "public/**", "taxi-dispatch.sqlite"]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "server.ts"
    }
  ],
  "env": {
    "ADMIN_KEY": "taxi-admin-2025"
  }
}
