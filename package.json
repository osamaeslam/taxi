{
  "name": "whatsapp-taxi-dispatch",
  "version": "1.0.0",
  "description": "بوت حجز تاكسي عبر واتساب — NLU قواعدي عامي + تسعير أحزمة + توزيع على السواقين | WhatsApp taxi dispatch bot (rules-based Syrian dialect NLU, zone pricing, driver dispatch)",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "lint": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "gateway": "node gateway/start.mjs"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260919.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "esbuild": "^0.25.0",
    "sharp": "^0.35.4",
    "tsx": "^4.21.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
